# ─────────────────────────────────────────────────────────────────
# SocietyDesk — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string.
# For local:   postgresql://postgres:postgres@localhost:5432/society_desk
# For Neon:    postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/society_desk"

# ─── JWT ─────────────────────────────────────────────────────────
# Long, random string. Generate one with: openssl rand -hex 64
JWT_SECRET="replace-with-a-long-random-secret-key"

# ─── Cloudinary (photo uploads) ──────────────────────────────────
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Resend (email notifications) ────────────────────────────────
# Sign up free at https://resend.com → API Keys → Create Key
# Leave blank to disable email; the app will skip sending gracefully.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Sender address shown in the From header.
# Must match a verified domain in your Resend account.
# The default Resend sandbox address works for testing:
EMAIL_FROM="SocietyDesk <onboarding@resend.dev>"

# ─── SMTP fallback (optional) ────────────────────────────────────
# Used only if RESEND_API_KEY is empty.
# Works with Gmail App Passwords — NOT your regular Gmail password.
# Enable at: https://myaccount.google.com/apppasswords
SMTP_USER=""
SMTP_PASS=""

# ─── CORS (Vercel deployment) ────────────────────────────────────
# Set this to your deployed frontend URL to allow cross-origin requests.
# Example: https://society-desk.vercel.app
# Leave as localhost for local development.
FRONTEND_URL="http://localhost:5173"
